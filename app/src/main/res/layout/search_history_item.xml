<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_history_tab"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/liquid_glass_search_item"
    android:focusable="true"
    android:nextFocusRight="@id/home_history_remove"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/history_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/search_hint"
        android:padding="10dp"
        android:src="@drawable/search_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/grayTextColor" />

    <TextView
        android:id="@+id/home_history_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="?attr/textColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/home_history_remove"
        app:layout_constraintStart_toEndOf="@id/history_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Recently searched title" />

    <ImageView
        android:id="@+id/home_history_remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/liquid_glass_search_action"
        android:contentDescription="@string/search_hint"
        android:focusable="true"
        android:nextFocusLeft="@id/home_history_tab"
        android:padding="12dp"
        android:src="@drawable/ic_baseline_close_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/grayTextColor" />
</androidx.constraintlayout.widget.ConstraintLayout>
