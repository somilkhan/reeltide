<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <ImageView
        android:id="@+id/home_scroll_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@drawable/example_poster" />

    <View
        android:id="@+id/title_shadow_top"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="top"
        android:alpha="0.72"
        android:background="@drawable/background_shadow"
        android:rotation="180"
        android:visibility="visible" />

    <View
        android:id="@+id/title_shadow"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:alpha="0.98"
        android:background="@drawable/background_shadow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="118dp"
        android:gravity="bottom|start"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/home_preview_logo"
            android:layout_width="210dp"
            android:layout_height="112dp"
            android:contentDescription="@null"
            android:scaleType="fitStart"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/home_scroll_preview_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/home_hero_badge"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/home_text_primary"
            android:textSize="12sp"
            android:fontFamily="@font/google_sans"
            android:textFontWeight="700"
            tools:text="Drama • Historical" />

        <TextView
            android:id="@+id/home_scroll_preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:gravity="start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="1.02"
            android:maxLines="2"
            android:textColor="@color/home_text_primary"
            android:textFontWeight="800"
            android:textSize="34sp"
            tools:text="Ibíten Konai Gibo to Gishi" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_preview_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="@color/home_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/google_sans"
                android:textFontWeight="500"
                tools:text="8.4" />

            <TextView
                android:id="@+id/home_preview_year_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="•"
                android:textColor="@color/home_text_tertiary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_preview_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/home_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/google_sans"
                android:textFontWeight="500"
                tools:text="2026" />

            <TextView
                android:id="@+id/home_preview_duration_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="7dp"
                android:text="•"
                android:textColor="@color/home_text_tertiary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_preview_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/home_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/google_sans"
                android:textFontWeight="500"
                tools:text="2h 10m" />

            <TextView
                android:id="@+id/home_preview_rating_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="7dp"
                android:text="•"
                android:textColor="@color/home_text_tertiary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_preview_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/home_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/google_sans"
                android:textFontWeight="500"
                android:visibility="gone"
                tools:text="8.4" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_preview_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.5"
            android:maxLines="2"
            android:textColor="@color/home_text_secondary"
            android:textFontWeight="400"
            android:textSize="14sp"
            tools:text="Miya, hija ilegítima de una influyente familia, pierde a su madre y es enviada a vivir con la esposa legítima ..." />
    </LinearLayout>
</FrameLayout>
