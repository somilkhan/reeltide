<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="112dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/google_sans"
                android:letterSpacing="0.16"
                android:text="SETTINGS"
                android:textColor="?attr/grayTextColor"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/settings_profile"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/liquid_glass_settings_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="18dp"
                tools:visibility="visible">

                <androidx.cardview.widget.CardView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:foreground="@drawable/outline_big_25_gray"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="31dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/settings_profile_pic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/account"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/profile_bg_orange" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/settings_profile_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans"
                        android:textColor="?attr/textColor"
                        android:textSize="20sp"
                        android:textStyle="normal"
                        tools:text="Default" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/google_sans"
                        android:text="Settings"
                        android:textColor="?attr/grayTextColor"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="›"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="30sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/google_sans"
                android:text="Preferences"
                android:textColor="?attr/textColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/settings_general"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/liquid_glass_settings_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusDown="@id/settings_player"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans"
                        android:text="@string/category_general"
                        android:textColor="?attr/textColor"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Language, downloads, ISP bypasses and links"
                        android:textColor="?attr/grayTextColor"
                        android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/grayTextColor" android:textSize="28sp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_player"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/liquid_glass_settings_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@id/settings_general"
                android:nextFocusDown="@id/settings_providers"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/google_sans" android:text="@string/category_player" android:textColor="?attr/textColor" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Subtitles, playback, gestures, layout and cache" android:textColor="?attr/grayTextColor" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/grayTextColor" android:textSize="28sp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_providers"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/liquid_glass_settings_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@id/settings_player"
                android:nextFocusDown="@id/settings_ui"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/google_sans" android:text="@string/category_providers" android:textColor="?attr/textColor" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Sources, providers and site preferences" android:textColor="?attr/grayTextColor" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/grayTextColor" android:textSize="28sp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_ui"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/liquid_glass_settings_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@id/settings_providers"
                android:nextFocusDown="@id/settings_updates"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/google_sans" android:text="@string/category_ui" android:textColor="?attr/textColor" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Appearance, poster layout and interface behavior" android:textColor="?attr/grayTextColor" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/grayTextColor" android:textSize="28sp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_updates"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/liquid_glass_settings_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@id/settings_ui"
                android:nextFocusDown="@id/settings_credits"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/google_sans" android:text="@string/category_updates" android:textColor="?attr/textColor" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="App updates, backup, extensions and actions" android:textColor="?attr/grayTextColor" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/grayTextColor" android:textSize="28sp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_credits"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/liquid_glass_settings_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@id/settings_updates"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/google_sans" android:text="@string/category_account" android:textColor="?attr/textColor" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Accounts and security" android:textColor="?attr/grayTextColor" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/grayTextColor" android:textSize="28sp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_extensions"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/liquid_glass_settings_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@id/settings_credits"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/google_sans" android:text="@string/extensions" android:textColor="?attr/textColor" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Add and manage repositories" android:textColor="?attr/grayTextColor" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/grayTextColor" android:textSize="28sp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/app_version_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView android:id="@+id/app_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:textColor="?attr/grayTextColor" android:textSize="12sp" tools:text="4.8.0-PRE" />
                <TextView android:id="@+id/delimiter0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•" android:textColor="?attr/grayTextColor" />
                <TextView android:id="@+id/commit_hash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:textColor="?attr/grayTextColor" android:textSize="12sp" tools:text="1234567" />
                <TextView android:id="@+id/delimiter1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•" android:textColor="?attr/grayTextColor" />
                <TextView android:id="@+id/build_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:textColor="?attr/grayTextColor" android:textSize="12sp" tools:text="21/03/2024 09:02 pm" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
