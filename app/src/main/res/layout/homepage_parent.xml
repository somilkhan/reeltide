<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/home_child_more_info"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/liquid_glass_pill"
            android:contentDescription="@string/home_more_info"
            android:gravity="center_vertical"
            android:maxWidth="300dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/textColor"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="Trending Right Now" />

        <TextView
            android:id="@+id/home_child_more_info_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|end"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/home_more_info"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusLeft="@id/home_child_more_info"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:text="View All"
            android:textColor="@color/textColor"
            android:textSize="14sp"
            android:textStyle="bold"
            app:drawableRightCompat="@drawable/ic_baseline_arrow_forward_24"
            app:drawableTint="@color/textColor" />

    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_child_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/home_child_more_info"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="3dp"
        tools:listitem="@layout/home_result_grid"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
