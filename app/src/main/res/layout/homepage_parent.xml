<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="26dp"
    android:paddingBottom="14dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">
        <TextView
            android:id="@+id/home_child_more_info"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="center_vertical|start"
            android:background="@android:color/transparent"
            android:contentDescription="@string/home_more_info"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxWidth="300dp"
            android:maxLines="1"
            android:paddingEnd="8dp"
            android:textColor="@color/home_text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="Latest Releases" />
        <TextView
            android:id="@+id/home_child_more_info_button"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="center_vertical|end"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/home_more_info"
            android:focusable="true"
            android:fontFamily="@font/google_sans"
            android:gravity="center_vertical"
            android:nextFocusLeft="@id/home_child_more_info"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:text="View all"
            android:textColor="@color/home_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:drawableRightCompat="@drawable/ic_baseline_arrow_forward_24"
            app:drawableTint="@color/home_text_secondary" />
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_child_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/home_child_more_info"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:scrollbars="none"
        tools:listitem="@layout/home_result_grid"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
