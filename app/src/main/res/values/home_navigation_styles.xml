<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HomeBottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">@dimen/home_nav_item_width</item>
        <item name="android:height">@dimen/home_nav_item_width</item>
        <item name="android:color">@color/transparent</item>
        <item name="marginHorizontal">0dp</item>
        <item name="expandedWidth">-2</item>
        <item name="expandedHeight">@dimen/home_nav_item_width</item>
        <item name="expandedActiveIndicatorPaddingStart">12dp</item>
        <item name="expandedActiveIndicatorPaddingEnd">12dp</item>
        <item name="expandedActiveIndicatorPaddingTop">0dp</item>
        <item name="expandedActiveIndicatorPaddingBottom">0dp</item>
    </style>

    <style name="HomeBottomNavItemTextActive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/home_accent</item>
    </style>

    <style name="HomeBottomNavItemTextInactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/home_text_tertiary</item>
    </style>
</resources>
