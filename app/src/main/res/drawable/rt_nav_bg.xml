<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#38FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#20FFFFFF" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
            <padding android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <solid android:color="#CC0A0C10" />
            <corners android:radius="25dp" />
            <stroke android:width="1dp" android:color="#12FFFFFF" />
        </shape>
    </item>
</layer-list>
