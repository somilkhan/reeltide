<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark translucent glass surface -->
    <item>
        <shape>
            <solid android:color="#A60B0C11" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#42FFFFFF" />
        </shape>
    </item>
    <!-- Inner edge highlight for a subtle frosted-glass silhouette. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#16FFFFFF" />
        </shape>
    </item>
</layer-list>