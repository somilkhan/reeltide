<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent outer glass surface -->
    <item>
        <shape>
            <solid android:color="#D90B0C11" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
    <!-- Fine inner highlight gives the pill a glass edge without changing its silhouette. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="#12FFFFFF" />
        </shape>
    </item>
</layer-list>
