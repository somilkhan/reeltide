<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F21A1A1D" />
            <stroke android:width="1dp" android:color="#4AFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#EE151517" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D90E0E10" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
