<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#EE171719" />
            <stroke android:width="1dp" android:color="#4AFFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F21A1A1D" />
            <stroke android:width="1dp" android:color="#3CFFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6111113" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</selector>
