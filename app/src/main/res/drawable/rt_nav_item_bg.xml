<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset
            android:insetLeft="11dp"
            android:insetTop="11dp"
            android:insetRight="11dp"
            android:insetBottom="11dp">
            <layer-list>
                <item>
                    <shape>
                        <solid android:color="#26FFFFFF" />
                        <corners android:radius="21dp" />
                        <stroke android:width="1dp" android:color="#20FFFFFF" />
                    </shape>
                </item>
                <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                    <shape>
                        <solid android:color="@android:color/transparent" />
                        <corners android:radius="20dp" />
                        <stroke android:width="1dp" android:color="#10FFFFFF" />
                    </shape>
                </item>
            </layer-list>
        </inset>
    </item>
    <item>
        <inset
            android:insetLeft="11dp"
            android:insetTop="11dp"
            android:insetRight="11dp"
            android:insetBottom="11dp">
            <shape>
                <solid android:color="#0DFFFFFF" />
                <corners android:radius="21dp" />
            </shape>
        </inset>
    </item>
</selector>
