        </inset>
    </item>
    <item>
        <inset android:insetLeft="8dp" android:insetTop="8dp" android:insetRight="8dp" android:insetBottom="8dp">
            <shape>
                <solid android:color="@color/rt_surface" />
                <corners android:radius="24dp" />
            </shape>
        </inset>
    </item>
</selector>
