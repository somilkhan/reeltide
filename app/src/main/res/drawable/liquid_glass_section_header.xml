<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E01A1A1D" />
            <stroke android:width="1dp" android:color="#3AFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#DE151517" />
            <stroke android:width="1dp" android:color="#34FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D90B0B0D" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
